# === VERCEL ONLY — set these in Vercel Dashboard → Settings → Environment Variables ===
# URL of the deployed toolz-downloadz-api (Vercel project). Must be https://... without trailing slash.
API_URL=https://toolz-downloadz-api.vercel.app
# Must match API_SECRET_KEY from toolz-downloadz-api env (same value in both projects)
API_SECRET_KEY=your_very_secure_secret_here

# Next.js public (optional, not used — keep as /api for same-origin proxy)
NEXT_PUBLIC_API_URL=/api
